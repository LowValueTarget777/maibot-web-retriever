{
  "manifest_version": 2,
  "id": "LowValueTarget.maibot-web-retriever",
  "version": "0.1.2",
  "name": "maibot-web-retriever",
  "description": "基于 SearXNG + Crawl4AI 的网页检索插件，为 MaiBot 提供网页搜索与内容抓取能力。搜索-决策-抓取：AI 自主选择感兴趣的网页并抓取全文 Markdown。",
  "author": {
    "name": "LowValueTarget",
    "url": "https://github.com/LowValueTarget777"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/LowValueTarget777/maibot-web-retriever",
    "homepage": "https://github.com/LowValueTarget777/maibot-web-retriever",
    "issues": "https://github.com/LowValueTarget777/maibot-web-retriever/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    }
  ],
  "capabilities": ["send.text", "llm.generate"],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": ["zh-CN"]
  }
}
